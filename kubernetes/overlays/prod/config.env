# ===== prod 環境のアプリ設定（ConfigMap になる）=====
# この値を変えて PR → Merge すると、ConfigMap の名前ハッシュが変わり Pod がローリング更新される。
# ★ LAB T07: メッセージを変えて、curl の結果が変わることを確認する
APP_MESSAGE=Hello from My Cloud Platform
APP_ENV=prod
# ★ LAB T09: debug にすると /healthz 等のアクセスログも出る
LOG_LEVEL=info
# ★ LAB T09: LATENCY_MS より短くすると 503 (request timeout) になる
REQUEST_TIMEOUT=5s
# ★ LAB T09: /upstream の再試行回数
MAX_RETRY=3
# ★ LAB M03 / I07: "/" が 500 を返す確率 (0-100)
ERROR_RATE=0
# ★ LAB M04: "/" の人工遅延 (ms)
LATENCY_MS=0
# ★ LAB T11: 起動に時間がかかるアプリを再現（startupProbe の教材）
STARTUP_DELAY_SECONDS=0
# ★ LAB T05 / I09: 起動時に確保するメモリ。memory limit を超えると OOMKilled
MEMORY_BALLAST_MB=0
# ★ LAB T17 / I12: 外部 API の URL（DNS / Network の教材）
UPSTREAM_URL=
# ★ LAB T18 / I06: true にすると Secret の API_KEY が必須になる
REQUIRE_API_KEY=false
